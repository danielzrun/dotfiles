{
  "env": {
    "MAX_MCP_OUTPUT_TOKENS": "64000",
    "BASH_DEFAULT_TIMEOUT_MS": "300000",
    "BASH_MAX_TIMEOUT_MS": "900000",
    "MAX_THINKING_TOKENS": "16384",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "64000",
    "CLAUDE_CODE_FILE_READ_MAX_OUTPUT_TOKENS": "45000",
    "CLAUDE_CODE_DISABLE_UNKNOWN_MODEL_WINDOW_ENFORCEMENT": "1",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "1000000",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": 1,
    "API_TIMEOUT_MS": "3000000",
    "DISABLE_AUTOUPDATER": "1"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git mv:*)",
      "Bash(git stash:*)",
      "Bash(pwd)",
      "Bash(env)",
      "Bash(true)",
      "Bash(ccusage daily:*)",
      "Bash(uv run:*)",
      "Bash(uv venv:*)",
      "Bash(uv pip install:*)",
      "Bash(pip install:*)",
      "Bash(python:*)",
      "Bash(.venv/bin/python:*)",
      "Bash(.venv/bin/pip:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(chmod:*)",
      "Bash(curl:*)",
      "Bash(sh:*)",
      "Bash(uv:*)",
      "Bash(pkill:*)",
      "Bash(lsof:*)",
      "Bash(xargs:*)",
      "Bash(./start.sh:*)",
      "Bash(timeout:*)",
      "Bash(gtimeout:*)",
      "Bash(zai:*)",
      "Bash(gemini:*)",
      "Bash(mcp:*)",
      "Bash(claude config get)",
      "Bash(claude mcp:*)",
      "mcp__cf-docs__*",
      "mcp__context7__*",
      "mcp__gemini-cli__*",
      "mcp__ide__*",
      "mcp__chrome-devtools__*",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:docs.z.ai)",
      "WebFetch(domain:pypi.org)",
      "WebSearch"
    ],
    "deny": [
      "Bash(rm -rf /:*)",
      "Bash(sudo:*)",
      "Bash(reboot)",
      "Bash(ls /)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.env)",
      "Read(~/.env.*)",
      "Read(~/.ssh/*)",
      "Read(~/.ssh/id_*)",
      "Read(~/.aws/credentials)"
    ],
    "defaultMode": "plan"
  },
  "model": "sonnet",
  "statusLine": {
    "type": "command",
    "command": "bash -c '\"$HOME/.bun/bin/bun\" \"$(ls -td ~/.claude/plugins/cache/claude-hud/claude-hud/*/ 2>/dev/null | head -1)src/index.ts\"'"
  },
  "enabledPlugins": {
    "claude-hud@claude-hud": true,
    "commit-commands@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "karpathy-skills": {
      "source": {
        "source": "github",
        "repo": "forrestchang/andrej-karpathy-skills"
      }
    },
    "claude-code-workflows": {
      "source": {
        "source": "github",
        "repo": "wshobson/agents"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-ansi",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"$HOME/.orca/agent-hooks/claude-hook.sh\" 2>/dev/null || cat >/dev/null 2>&1 || :",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"$HOME/.orca/agent-hooks/claude-hook.sh\" 2>/dev/null || cat >/dev/null 2>&1 || :",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"$HOME/.orca/agent-hooks/claude-hook.sh\" 2>/dev/null || cat >/dev/null 2>&1 || :",
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"$HOME/.orca/agent-hooks/claude-hook.sh\" 2>/dev/null || cat >/dev/null 2>&1 || :",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"$HOME/.orca/agent-hooks/claude-hook.sh\" 2>/dev/null || cat >/dev/null 2>&1 || :",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"$HOME/.orca/agent-hooks/claude-hook.sh\" 2>/dev/null || cat >/dev/null 2>&1 || :",
            "timeout": 10
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"$HOME/.orca/agent-hooks/claude-hook.sh\" 2>/dev/null || cat >/dev/null 2>&1 || :",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"$HOME/.orca/agent-hooks/claude-hook.sh\" 2>/dev/null || cat >/dev/null 2>&1 || :",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"$HOME/.orca/agent-hooks/claude-hook.sh\" 2>/dev/null || cat >/dev/null 2>&1 || :",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"$HOME/.orca/agent-hooks/claude-hook.sh\" 2>/dev/null || cat >/dev/null 2>&1 || :",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"$HOME/.orca/agent-hooks/claude-hook.sh\" 2>/dev/null || cat >/dev/null 2>&1 || :",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
