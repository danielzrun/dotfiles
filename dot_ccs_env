# Claude Code Provider Configuration
# Options: default, zhipu, ark

export CLAUDE_PROVIDER="default"

# =============================================================================
# Zhipu AI Configuration
# =============================================================================
if [[ "$CLAUDE_PROVIDER" == "zhipu" || "$CLAUDE_PROVIDER" == "default" ]]; then
    export ANTHROPIC_AUTH_TOKEN="$ZHIPU_AUTH_TOKEN"
    export ANTHROPIC_DEFAULT_OPUS_MODEL="glm-5.3[1m]"
    export ANTHROPIC_DEFAULT_SONNET_MODEL="glm-5.3[1m]"
    export ANTHROPIC_DEFAULT_HAIKU_MODEL="glm-5.3-flash[1m]"
    export ANTHROPIC_BASE_URL="https://open.bigmodel.cn/api/anthropic"
fi

# =============================================================================
# Ark AI Configuration
# =============================================================================
if [[ "$CLAUDE_PROVIDER" == "ark" ]]; then
    export ANTHROPIC_AUTH_TOKEN="$ARK_BEARER_TOKEN"
    export ANTHROPIC_DEFAULT_OPUS_MODEL="Doubao-Seed-Evolving[1m]"
    export ANTHROPIC_DEFAULT_SONNET_MODEL="doubao-seed-2-1-turbo-260628"
    export ANTHROPIC_DEFAULT_HAIKU_MODEL="Doubao-Seed-2.0-mini"
    export ANTHROPIC_BASE_URL="https://ark.cn-beijing.volces.com/api/plan"
fi
